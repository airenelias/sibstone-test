<article class="detail" style="background-color: var(--detail-card-background-color)">
    <label>Название</label>
    <input type="text" name="name" placeholder="Название" />
    <label>Размер</label>
    <div style="display: flex;">
        <input type="number" name="width" min="0" placeholder="Ширина" />
        <p style="margin: 10px">x</p>
        <input type="number" name="length" min="0" placeholder="Длина" />
    </div>
    <label>Количество</label>
    <input type="number" name="quantity" min="0" placeholder="0" />
    <button id="detail-delete" style="background-color: darkred;">Удалить</button>
</article>
